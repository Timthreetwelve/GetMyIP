<UserControl x:Class="GetMyIP.Controls.TimeSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignHeight="34"
             d:DesignWidth="80">

    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     MinWidth="30"
                     Margin="6,0,0,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                     IsReadOnly="True"
                     IsHitTestVisible="False"
                     IsTabStop="False"
                     Style="{x:Null}"
                     Text="{Binding Value, ElementName=Root, StringFormat={}{0:00}}" />

            <StackPanel Grid.Column="1"
                        Orientation="Vertical">
                <RepeatButton Width="20" Height="14"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              Click="UpButton_Click"
                              Focusable="False"
                              Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                              materialDesign:RippleAssist.Feedback="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <materialDesign:PackIcon Width="14" Height="14"
                                              Kind="ChevronUp" />
                </RepeatButton>
                <RepeatButton Width="20" Height="14"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              Click="DownButton_Click"
                              Focusable="False"
                              Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                              materialDesign:RippleAssist.Feedback="{DynamicResource MaterialDesign.Brush.Foreground}">
                    <materialDesign:PackIcon Width="14" Height="14"
                                              Kind="ChevronDown" />
                </RepeatButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
