<UserControl x:Class="GetMyIP.Views.AdaptersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:config="clr-namespace:GetMyIP.Configuration"
             xmlns:convert="clr-namespace:GetMyIP.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GetMyIP.Models"
             xmlns:viewmodels="clr-namespace:GetMyIP.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:AdaptersViewModel}"
             TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <!--#region Resources-->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <convert:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <convert:SpacingConverter x:Key="Spacing" />
        <!--#region Detail Copy Button Style-->
        <Style TargetType="Button"
               x:Key="DetailCopyButtonStyle"
               BasedOn="{StaticResource CopyToClipboardButton}">
            <Setter Property="Margin" Value="10,0,0,2" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True" />
                        <Condition Binding="{Binding ShowCopyIcon, Source={x:Static config:UserSettings.Setting}}" Value="True" />
                        <Condition Binding="{Binding ElementName=AdaptersDataGrid, Path=SelectedItems.Count}" Value="1" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!--#endregion-->
    </UserControl.Resources>
    <!--#endregion-->

    <Grid>
        <!--#region Grid Row Definitions-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <!--#endregion-->

        <!--#region Filter Row-->
        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                BorderThickness="0,0,0,3"
                Visibility="{Binding ShowAdapterFilter,
                                     Source={x:Static config:UserSettings.Setting},
                                     Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Margin="0,0,0,5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Margin="15,6,0,0"
                           VerticalAlignment="Center"
                           Text="{StaticResource Adapters_Filter}" />
                <Border Margin="15,5,-5,0"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                        BorderThickness="1.5,0" />
                <CheckBox Margin="10,2,0,-2"
                          VerticalAlignment="Center"
                          Content="{StaticResource Adapters_ShowUp}"
                          IsChecked="{Binding ShowAdapterUpOnly,
                                              Source={x:Static config:UserSettings.Setting}}" />
                <CheckBox Margin="10,2,0,-2"
                          VerticalAlignment="Center"
                          Content="{StaticResource Adapters_ShowDown}"
                          IsChecked="{Binding ShowAdapterDownOnly,
                                              Source={x:Static config:UserSettings.Setting}}" />
                <Border Margin="15,5,-5,0"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                        BorderThickness="1.5,0" />
                <CheckBox Margin="10,2,0,-2"
                          VerticalAlignment="Center"
                          Content="{StaticResource Adapters_ShowEthernet}"
                          IsChecked="{Binding ShowEthernetOnly,
                                              Source={x:Static config:UserSettings.Setting}}" />
                <CheckBox Margin="10,2,0,-2"
                          VerticalAlignment="Center"
                          Content="{StaticResource Adapters_ShowWireless}"
                          IsChecked="{Binding ShowWirelessOnly,
                                              Source={x:Static config:UserSettings.Setting}}" />
                <CheckBox Margin="10,2,0,-2"
                          VerticalAlignment="Center"
                          Content="{StaticResource Adapters_ShowOther}"
                          IsChecked="{Binding ShowOtherOnly,
                                              Source={x:Static config:UserSettings.Setting}}" />
                <Border Margin="15,5,-5,0"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                        BorderThickness="1.5,0" />
                <CheckBox Margin="10,2,0,-2"
                          VerticalAlignment="Center"
                          Content="{StaticResource Adapters_ShowHasAddress}"
                          IsChecked="{Binding ShowHasAddressOnly,
                                              Source={x:Static config:UserSettings.Setting}}" />
                <Border Margin="15,5,-5,0"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                        BorderThickness="1.5,0" />
            </StackPanel>
        </Border>
        <!--#endregion-->

        <!--#region Data Grid-->
        <DataGrid x:Name="AdaptersDataGrid"
                  Grid.Row="1"
                  MinHeight="200"
                  materialDesign:DataGridAssist.CellPadding="{Binding RowSpacing,
                                                                      Source={x:Static config:UserSettings.Setting},
                                                                      Converter={StaticResource Spacing}}"
                  AutoGenerateColumns="False"
                  Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                  CellStyle="{StaticResource DgCellStyle}"
                  ColumnHeaderStyle="{StaticResource DgColumnHeader}"
                  FontFamily="{Binding SelectedFont,
                                       Source={x:Static config:UserSettings.Setting}}"
                  FontSize="{Binding SelectedFontSize,
                                     Source={x:Static config:UserSettings.Setting}}"
                  IsReadOnly="True"
                  ItemsSource="{Binding AdaptersList}"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectedItem="{Binding SelectedAdapter,
                                         Mode=TwoWay}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding AdapterType}"
                                    Header="{StaticResource Adapters_ColumnAdapterType}" />
                <DataGridTextColumn Binding="{Binding Status}"
                                    Header="{StaticResource Adapters_ColumnStatus}" />
                <DataGridTextColumn Binding="{Binding IpAddress}"
                                    Header="{StaticResource Adapters_ColumnIPv4Address}"
                                    Visibility="{Binding ShowAdapterIPv4,
                                                         Source={x:Static config:UserSettings.Setting},
                                                         Converter={StaticResource BoolToVisConverter}}" />
                <DataGridTextColumn Binding="{Binding IpV6Address}"
                                    Header="{StaticResource Adapters_ColumnIPv6Address}"
                                    Visibility="{Binding ShowAdapterIPv6,
                                                         Source={x:Static config:UserSettings.Setting},
                                                         Converter={StaticResource BoolToVisConverter}}" />
                <DataGridTextColumn Binding="{Binding Description}"
                                    Header="{StaticResource Adapters_ColumnDescription}"
                                    Visibility="{Binding ShowAdapterDescription,
                                                         Source={x:Static config:UserSettings.Setting},
                                                         Converter={StaticResource BoolToVisConverter}}" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  Empty State Message  -->
        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14" FontWeight="SemiBold"
                   Opacity=".6" TextAlignment="Center"
                   Visibility="{Binding AdaptersList.Count,
                                        Converter={StaticResource CountToVisibilityConverter}}">
            <Run Text="{StaticResource Adapters_AllAdaptersExcludedLine1}" />
            <LineBreak />
            <Run Text="{StaticResource Adapters_AllAdaptersExcludedLine2}" />
        </TextBlock>
        <!--#endregion-->

        <!--#region GridSplitter-->
        <GridSplitter Grid.Row="2"
                      Height="4"
                      Margin="4,5"
                      HorizontalAlignment="Stretch"
                      IsTabStop="False"
                      ResizeBehavior="PreviousAndNext"
                      Style="{StaticResource GridSplitterStyle}" />
        <!--#endregion-->

        <!--#region Details area in ScrollViewer-->
        <ScrollViewer Grid.Row="3"
                      MinHeight="100"
                      Margin="0,5,10,5"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Visible">
            <Grid Grid.Row="3"
                  MinHeight="100"
                  Margin="0,5,10,5"
                  VerticalAlignment="Top"
                  d:DataContext="{d:DesignInstance Type=models:Adapters}"
                  DataContext="{Binding ElementName=AdaptersDataGrid,
                                        Path=SelectedItem}">
                <!--#region Row & Column Definitions-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--#endregion-->

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="0,5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{StaticResource Adapters_DetailsTitle}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=AdaptersDataGrid, Path=SelectedItems.Count}"
                                             Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!--#region Fallback text if selected rows != 1-->
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Width="Auto"
                           Margin="5" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" Opacity=".6"
                           Text="{StaticResource Adapters_NoneSelectedLine1}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=AdaptersDataGrid, Path=SelectedItems.Count}"
                                             Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!--#endregion-->


                <!--#region Adapter Details-->
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailAdapterType}" />
                <Border Grid.Row="1" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding AdapterType}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding AdapterType}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailIpV4Address}" />
                <Border Grid.Row="2" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding IpAddress}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding IpAddress}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailIpV6Address}" />
                <Border Grid.Row="3" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding IpV6Address}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding IpV6Address}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailDescription}" />
                <Border Grid.Row="4" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Description}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding Description}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="5" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailName}" />
                <Border Grid.Row="5" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Name}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding Name}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="6" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailMacAddress}" />
                <Border Grid.Row="6" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding PhysicalAddress}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding PhysicalAddress}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="7" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailSubnetMask}" />
                <Border Grid.Row="7" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding SubnetMask}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding SubnetMask}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="8" Grid.Column="1"
                           Margin="10,5" VerticalAlignment="Center"
                           Text="{StaticResource Adapters_DetailDefaultGateway}" />
                <Border Grid.Row="8" Grid.Column="3"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding DefaultGateway}" />
                        <Button Command="{Binding DataContext.CopyCellValueCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding DefaultGateway}"
                                Style="{StaticResource DetailCopyButtonStyle}">
                            <materialDesign:PackIcon Width="16" Height="16"
                                                     Kind="ContentCopy" />
                        </Button>
                    </StackPanel>
                </Border>
                <!--#endregion-->
            </Grid>
        </ScrollViewer>
        <!--#endregion-->
    </Grid>

</UserControl>
